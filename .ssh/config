Host *
    # UseKeychain yes # mac-specific
    AddKeysToAgent yes

Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_github

Host gitlab.com
    HostName gitlab.com
    User git
    IdentityFile ~/.ssh/id_ed25519_gitlab

Host codeberg.org
    HostName codeberg.org
    User git
    IdentityFile ~/.ssh/codeberg_niccolozanotti

Host *sr.ht
    IdentityFile ~/.ssh/id_ed25519_srht
    PreferredAuthentications publickey

Host hf.co
    HostName hf.co
    User git
    IdentityFile ~/.ssh/huggingface_niccolozanotti

Host csd3
    HostName login.hpc.cam.ac.uk
    User nz306
    IdentityFile ~/.ssh/id_ed25519_cambridge
    PasswordAuthentication no        
    PubkeyAuthentication yes        
    StrictHostKeyChecking ask
    ControlMaster auto
    ControlPath ~/.ssh/control/%r@%h:%p
    ControlPersist 900
    ServerAliveInterval 60
    # Compression yes

Host lenovo
    HostName lenovo-ubuntu24.local
    User niccolozanotti
    IdentityFile ~/.ssh/ubuntu_lenovo
    PasswordAuthentication no
    PubkeyAuthentication yes
    StrictHostKeyChecking ask
    ControlMaster auto
    ControlPath ~/.ssh/control/%r@%h:%p
    ControlPersist 900
    ServerAliveInterval 60 # send packet every 60s

Host disi
    HostName giano.cs.unibo.it
    User niccolo.zanotti
    StrictHostKeyChecking ask
    ControlMaster auto
    ControlPath ~/.ssh/control/%r@%h:%p
    ControlPersist 900
    ServerAliveInterval 60 
    Compression yes

Host ugoserver
    User niccolozanotti
    HostName raspi.ugoforlimpopoli.org
    ProxyCommand /opt/homebrew/bin/cloudflared access ssh --hostname %h
    IdentityFile ~/.ssh/id_rsa_rpi_niccolozanotti
    PasswordAuthentication no        
    PubkeyAuthentication yes        
    StrictHostKeyChecking ask
    ControlMaster auto
    ControlPath ~/.ssh/control/%r@%h:%p
    ControlPersist 900
    ServerAliveInterval 60

Host forgejo.ugoforlimpopoli.org
    User git
    ProxyCommand cloudflared access ssh --hostname %h
    IdentityFile ~/.ssh/id_ed25519_forgejo

Host homerouter
    HostName 192.168.8.1
    User root
    IdentityFile ~/.ssh/id_ed25519_router
    PasswordAuthentication no
    PubkeyAuthentication yes
    StrictHostKeyChecking ask
    ControlMaster auto
    ControlPath ~/.ssh/control/%r@%h:%p
    ControlPersist 900
    ServerAliveInterval 60
    Compression yes

