Host *
    # UseKeychain yes # mac-specific
    AddKeysToAgent yes

Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/github_niccolozanotti

Host gitlab.com
    HostName gitlab.com
    User git
    IdentityFile ~/.ssh/gitlab_niccolozanotti

Host codeberg.org
    HostName codeberg.org
    User git
    IdentityFile ~/.ssh/codeberg_niccolozanotti

Host *sr.ht
    IdentityFile ~/.ssh/srht_niccolozanotti
    PreferredAuthentications publickey

Host hf.co
    HostName hf.co
    User git
    IdentityFile ~/.ssh/huggingface_niccolozanotti

Host csd3
    HostName login.hpc.cam.ac.uk
    User nz306
    IdentityFile ~/.ssh/id_ed25519_cambridge
    PasswordAuthentication no        
    PubkeyAuthentication yes        
    StrictHostKeyChecking ask
    ControlMaster auto
    ControlPath ~/.ssh/control/%r@%h:%p
    ControlPersist 900
    ServerAliveInterval 60
    # Compression yes

