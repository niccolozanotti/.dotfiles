Host *
    UseKeychain yes
    AddKeysToAgent yes

Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_github_imac

Host codeberg.org
    HostName codeberg.org
    User git
    IdentityFile ~/.ssh/id_ed25519_codeberg

Host *sr.ht
    IdentityFile ~/.ssh/id_ed25519_sourcehut
    PreferredAuthentications publickey

Host csd3
    HostName login.hpc.cam.ac.uk
    User nz306
    IdentityFile ~/.ssh/id_ed25519_cambridge
    PasswordAuthentication no        
    PubkeyAuthentication yes        
    StrictHostKeyChecking ask
    ControlMaster auto
    ControlPath ~/.ssh/control/%r@%h:%p
    ControlPersist 900
    ServerAliveInterval 60
    # Compression yes

Host disi
    HostName giano.cs.unibo.it
    User niccolo.zanotti
    StrictHostKeyChecking ask
    ControlMaster auto
    ControlPath ~/.ssh/control/%r@%h:%p
    ControlPersist 900
    ServerAliveInterval 60 
    Compression yes

Host raspberrypi
    HostName raspberrypi.local
    User niccolozanotti
    IdentityFile ~/.ssh/id_ed25519_raspberrypi
    PasswordAuthentication no        
    PubkeyAuthentication yes        
    StrictHostKeyChecking ask
