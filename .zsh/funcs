################ UTILITIES ###############
cdls() { cd "$@" && ls; }

skimopen(){ open "$@" -a skim; }

wgconnect()
# Wireguard homevpn server
{
    sudo wg-quick up ~/.wireguard/macbook_client.conf
    echo "Connection status:"
    sudo wg show
}
wgdisconnect()
{
    sudo wg-quick down ~/.wireguard/macbook_client.conf;
    echo "WireGuard disconnected";
}
wgstatus() {
    sudo wg show
}

en-it()
{
  # Initialize an empty string to hold the concatenated result
  input_string=""
  # Loop through all the arguments
  for arg in "$@"
  do
      #  empty input_string
      if [ -z "$input_string" ]; then
          input_string="$arg"
      else
          # %20 for url whitespace
          input_string="$input_string%20$arg"
      fi
  done
  # Looking the corresponding address on wordreference.com
  open "https://www.wordreference.com/enit/$input_string"
}

